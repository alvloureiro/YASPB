{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default build configuration with examples enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "ON",
        "ENABLE_AVFOUNDATION_BACKEND": "ON",
        "ENABLE_MOCK_BACKEND": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with examples enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "ON",
        "ENABLE_AVFOUNDATION_BACKEND": "ON",
        "ENABLE_MOCK_BACKEND": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with examples enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "OFF",
        "ENABLE_AVFOUNDATION_BACKEND": "ON",
        "ENABLE_MOCK_BACKEND": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}

