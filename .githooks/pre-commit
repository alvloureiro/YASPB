#!/bin/bash
#
# Pre-commit hook for StreamingPlayback project
# Runs C++ linters and formatters before allowing commit
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Track if any checks failed
FAILED=0

echo -e "${GREEN}Running pre-commit checks...${NC}"

# Get list of staged C++ files
STAGED_CPP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|h|cc|cxx)$' || true)

if [ -z "$STAGED_CPP_FILES" ]; then
    echo -e "${GREEN}No C++ files staged for commit.${NC}"
    exit 0
fi

echo -e "${YELLOW}Staged C++ files:${NC}"
echo "$STAGED_CPP_FILES" | sed 's/^/  /'

# Check if clang-format is available
if ! command -v clang-format &> /dev/null; then
    echo -e "${YELLOW}Warning: clang-format not found. Skipping format check.${NC}"
    echo -e "${YELLOW}Install with: brew install clang-format (macOS) or apt-get install clang-format (Linux)${NC}"
else
    echo -e "\n${GREEN}Checking code formatting with clang-format...${NC}"
    
    # Check formatting for each staged file
    MISFORMATTED_FILES=()
    for file in $STAGED_CPP_FILES; do
        if [ -f "$file" ]; then
            if ! clang-format --dry-run --Werror "$file" &> /dev/null; then
                MISFORMATTED_FILES+=("$file")
            fi
        fi
    done
    
    if [ ${#MISFORMATTED_FILES[@]} -gt 0 ]; then
        echo -e "${RED}Error: The following files are not properly formatted:${NC}"
        for file in "${MISFORMATTED_FILES[@]}"; do
            echo -e "  ${RED}$file${NC}"
        done
        echo -e "\n${YELLOW}Run the following to fix formatting:${NC}"
        echo -e "  ${YELLOW}clang-format -i ${MISFORMATTED_FILES[*]}${NC}"
        echo -e "\n${YELLOW}Or format all staged files:${NC}"
        echo -e "  ${YELLOW}git diff --cached --name-only --diff-filter=ACM | grep -E '\\.(cpp|hpp|h|cc|cxx)$' | xargs clang-format -i${NC}"
        FAILED=1
    else
        echo -e "${GREEN}✓ All files are properly formatted.${NC}"
    fi
fi

# Check if clang-tidy is available
if ! command -v clang-tidy &> /dev/null; then
    echo -e "${YELLOW}Warning: clang-tidy not found. Skipping static analysis.${NC}"
    echo -e "${YELLOW}Install with: brew install llvm (macOS) or apt-get install clang-tidy (Linux)${NC}"
else
    echo -e "\n${GREEN}Running static analysis with clang-tidy...${NC}"
    
    # Check if compile_commands.json exists (needed for clang-tidy)
    if [ ! -f "$REPO_ROOT/compile_commands.json" ]; then
        echo -e "${YELLOW}Warning: compile_commands.json not found.${NC}"
        echo -e "${YELLOW}Generate it by configuring CMake with: cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON${NC}"
        echo -e "${YELLOW}Skipping clang-tidy checks.${NC}"
    else
        # Run clang-tidy on staged files
        TIDY_FAILED=0
        for file in $STAGED_CPP_FILES; do
            if [ -f "$file" ]; then
                echo -e "  Checking ${file}..."
                if ! clang-tidy "$file" --quiet 2>&1 | grep -q "error:"; then
                    # Check if there are any warnings/errors
                    TIDY_OUTPUT=$(clang-tidy "$file" 2>&1 || true)
                    if echo "$TIDY_OUTPUT" | grep -qE "(error|warning):"; then
                        echo -e "${RED}  ✗ Issues found in $file:${NC}"
                        echo "$TIDY_OUTPUT" | grep -E "(error|warning):" | head -5 | sed 's/^/    /'
                        TIDY_FAILED=1
                    fi
                fi
            fi
        done
        
        if [ $TIDY_FAILED -eq 1 ]; then
            echo -e "${RED}✗ Static analysis found issues.${NC}"
            FAILED=1
        else
            echo -e "${GREEN}✓ Static analysis passed.${NC}"
        fi
    fi
fi

# Summary
echo ""
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}✗ Pre-commit checks failed. Please fix the issues above before committing.${NC}"
    exit 1
else
    echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
    exit 0
fi

